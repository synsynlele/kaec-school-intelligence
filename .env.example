# KAEC School Intelligence — public Supabase browser configuration
# Use the dedicated KSI project only. Never point this app at pipupath-staging.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# OpenAI configuration — server only.
# Add real values directly to the deployment environment. Never commit or expose them to the browser.
OPENAI_API_KEY=replace_in_server_environment
# Shared by every AI route. Set explicitly for the deployment environment.
KSI_OPENAI_MODEL=gpt-6-luna
# Optional reasoning overrides by task. Luna accepts none, low, medium, high, xhigh and max.
# Omit to use the per-task defaults, including low for capped HQLS repairs.
# KSI_AI_REASONING_QUICK=none
# KSI_AI_REASONING_STANDARD=low
# KSI_AI_REASONING_REPAIR=

# KSI school-issued parent accounts — server only. Use the same Supabase project as the public URL.
KSI_SUPABASE_ADMIN_KEY=replace_in_server_environment
