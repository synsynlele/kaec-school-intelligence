# KAEC School Intelligence — public Supabase browser configuration
# Use the dedicated KSI project only. Never point this app at pipupath-staging.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# OpenAI configuration — server only.
# Add real values directly to the deployment environment. Never commit or expose them to the browser.
OPENAI_API_KEY=replace_in_server_environment

# Quality-first low-cost policy.
# The primary model handles normal HQLS and Assessment generation.
KSI_OPENAI_PRIMARY_MODEL=gpt-4o-mini
# Repair calls use the stronger fallback only when the primary output fails KAEC validation.
KSI_OPENAI_REPAIR_MODEL=gpt-5-mini

# Legacy compatibility only: KSI_OPENAI_MODEL / KSI_AI_MODEL are still read when
# KSI_OPENAI_PRIMARY_MODEL is absent. Prefer KSI_OPENAI_PRIMARY_MODEL for new deployments.
